function txt(s, x, y, size, col, o = {}) {
  ctx.save(); ctx.font = font(o.w || 900, size, o.f || F); ctx.textAlign = o.align || 'center'; ctx.textBaseline = 'middle'; ctx.fillStyle = col;
  if (o.ls) ctx.letterSpacing = o.ls + 'px'; if (o.shadow) { ctx.shadowColor = 'rgba(0,0,0,.6)'; ctx.shadowBlur = 20; }
  ctx.fillText(s, x, y); ctx.restore();
}
function label(s, x, y, t, a, col = C.yel, ink = C.ink, size = 34) {   // pop-in plate
  const k = pop(t, a); if (k <= 0) return;
  ctx.save(); ctx.translate(x, y); ctx.scale(k, k); ctx.font = font(900, size); const w = ctx.measureText(s).width + 36;
